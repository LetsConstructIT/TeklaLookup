<Project>

    <!--
        Local props for the TeklaLookup.App subtree.
        Stops MSBuild walk-up from inheriting the repo-root Revit-focused props.
    -->

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <PlatformTarget>x64</PlatformTarget>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

        <!-- Use plain PackageReference Version attributes inside this subtree -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

        <!--
            Drives TSAppConfigPatcherTask: it writes <codeBase> entries into TeklaLookup.exe.config
            pointing at the Tekla Structures GAC so Tekla.Structures.* assemblies resolve at runtime
            without needing the .exe to live inside Tekla's bin folder.
        -->
        <TeklaVersion>2026.0</TeklaVersion>
    </PropertyGroup>

</Project>
