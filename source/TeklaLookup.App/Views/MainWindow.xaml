<ui:FluentWindow x:Class="TeklaLookup.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://lookupengine.com/xaml"
        xmlns:vm="clr-namespace:TeklaLookup.App.ViewModels"
        Title="{Binding Title}" Height="700" Width="1300"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Topmost="{Binding IsTopmost}"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding NavigateBackCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.Resources>
        <!--
            The Fluent DataGridRow template maps IsSelected to the same subtle "PointerOver" tint
            it uses for hover, which makes a multi-row selection nearly invisible. Override both
            row background and cell foreground/background so selected rows clearly stand out.
        -->
        <Style x:Key="HighlightedRowStyle" TargetType="DataGridRow"
               BasedOn="{StaticResource DefaultDataGridRowStyle}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3D7BFF" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HighlightedCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3D7BFF" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#3D7BFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title}" />
        <DockPanel DockPanel.Dock="Top" Margin="12,8,12,8" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left"
                       Content="Load selected"
                       Icon="{ui:SymbolIcon Cursor24}"
                       Command="{Binding LoadSelectedCommand}"
                       Appearance="Primary"
                       Padding="12,4" Margin="0,0,8,0"
                       ToolTip="Decompose the current Tekla model / drawing selection" />

            <ui:DropDownButton DockPanel.Dock="Left"
                               Content="More"
                               Icon="{ui:SymbolIcon Apps24}"
                               Padding="12,4" Margin="0,0,8,0"
                               ToolTip="Other ways to load objects into TeklaLookup">
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Header="Decompose model root"     Command="{Binding LoadModelRootCommand}" />
                        <MenuItem Header="Decompose active view"    Command="{Binding LoadActiveViewCommand}" />
                        <MenuItem Header="Decompose active drawing" Command="{Binding LoadActiveDrawingCommand}" />
                        <MenuItem Header="Load reference models"    Command="{Binding LoadReferenceModelsCommand}" />
                        <MenuItem Header="Load drawings"            Command="{Binding LoadDrawingsCommand}" />
                        <Separator />
                        <MenuItem Header="Load by type…"            Command="{Binding LoadByTypeCommand}" />
                        <MenuItem Header="Search by ID / GUID…"     Command="{Binding SearchByIdCommand}" />
                        <MenuItem Header="Load all model objects"   Command="{Binding LoadAllCommand}" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>

            <ui:DropDownButton DockPanel.Dock="Left"
                               Content="Pick"
                               Icon="{ui:SymbolIcon TargetArrow24}"
                               Padding="12,4" Margin="0,0,16,0"
                               ToolTip="Pick objects from the Tekla viewport">
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Header="One object…"   Command="{Binding PickObjectCommand}" />
                        <MenuItem Header="Many objects…" Command="{Binding PickObjectsCommand}" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>

            <ui:Button DockPanel.Dock="Left"
                       Content="Clear overlays"
                       Icon="{ui:SymbolIcon EraserTool24}"
                       Command="{Binding ClearHighlightsCommand}"
                       Padding="12,4" Margin="0,0,8,0"
                       ToolTip="Remove all temporary graphics drawn in the Tekla viewport" />
            <ui:Button DockPanel.Dock="Left"
                       Content="Event monitor"
                       Icon="{ui:SymbolIcon Pulse24}"
                       Command="{Binding OpenEventMonitorCommand}"
                       Padding="12,4" Margin="0,0,8,0"
                       ToolTip="Live log of Tekla model and drawing events" />
            <ui:DropDownButton DockPanel.Dock="Left"
                               Content="History"
                               Icon="{ui:SymbolIcon History24}"
                               Padding="12,4"
                               Tag="{Binding}"
                               ToolTip="Recently viewed decomposition trails (most recent first)">
                <ui:DropDownButton.Flyout>
                    <ContextMenu Tag="{Binding}"
                                 ItemsSource="{Binding History}">
                        <ContextMenu.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding DisplayPath}" />
                                <Setter Property="ToolTip" Value="{Binding Timestamp, StringFormat='Captured {0:HH:mm:ss}'}" />
                                <Setter Property="Command"
                                        Value="{Binding Tag.RestoreHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                            </Style>
                        </ContextMenu.Resources>
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>

            <ToggleButton DockPanel.Dock="Right"
                          IsChecked="{Binding IsTopmost}"
                          Padding="12,4"
                          ToolTip="Keep window always on top of Tekla">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Pin24" Margin="0,0,6,0" />
                    <TextBlock Text="Pin on top" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <ui:DropDownButton DockPanel.Dock="Right"
                               Content="Theme"
                               Icon="{ui:SymbolIcon PaintBrush24}"
                               Padding="12,4" Margin="0,0,8,0"
                               ToolTip="Switch UI theme">
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Header="Light"
                                  Command="{Binding ApplyThemeCommand}" CommandParameter="Light" />
                        <MenuItem Header="Dark"
                                  Command="{Binding ApplyThemeCommand}" CommandParameter="Dark" />
                        <MenuItem Header="High contrast"
                                  Command="{Binding ApplyThemeCommand}" CommandParameter="HighContrast" />
                        <Separator />
                        <MenuItem Header="Match Windows"
                                  Command="{Binding ApplyThemeCommand}" CommandParameter="Auto" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding Status}"
                   Margin="12,4,12,8" Foreground="#555" />

        <Grid Margin="12,4,12,4">
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Object list -->
            <DockPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBox DockPanel.Dock="Top"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,4"
                         Padding="4,2"
                         ToolTip="Filter by type, name, profile, material, class, GUID, or ID" />
            <DataGrid Name="ObjectsGrid"
                      ItemsSource="{Binding ObjectsView}"
                      SelectedItem="{Binding SelectedObject}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      ColumnWidth="SizeToCells"
                      SelectionMode="Extended"
                      RowStyle="{StaticResource HighlightedRowStyle}"
                      CellStyle="{StaticResource HighlightedCellStyle}"
                      PreviewMouseRightButtonDown="OnObjectsPreviewRightDown">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Select in Tekla"
                                  Command="{Binding PlacementTarget.DataContext.ShowInTeklaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Open in new window"
                                  Command="{Binding PlacementTarget.DataContext.OpenSnapshotInNewWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Save as JSON (for LLM)…"
                                  Command="{Binding PlacementTarget.DataContext.DumpJsonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Copy GUID"
                                  Command="{Binding PlacementTarget.DataContext.CopySnapshotGuidCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Copy ID"
                                  Command="{Binding PlacementTarget.DataContext.CopySnapshotIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Copy summary"
                                  Command="{Binding PlacementTarget.DataContext.CopySnapshotSummaryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Resources>
                    <Style x:Key="CellWithTooltip" TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="28" CanUserResize="False" CanUserReorder="False" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:SymbolIcon Symbol="{Binding Converter={StaticResource SnapshotIcon}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#666" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Type"    Binding="{Binding TypeName}"     Width="Auto" MinWidth="100" ElementStyle="{StaticResource CellWithTooltip}" />
                    <DataGridTextColumn Header="Id"      Binding="{Binding IdentifierId}" Width="Auto" MinWidth="50"  ElementStyle="{StaticResource CellWithTooltip}" />
                    <DataGridTextColumn Header="Summary" Binding="{Binding Summary}"      Width="*"    MinWidth="160" ElementStyle="{StaticResource CellWithTooltip}" />
                </DataGrid.Columns>
            </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4"
                          Margin="4,0,4,0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#DDD" />

            <!-- Decomposition pane -->
            <DockPanel Grid.Column="2" Margin="4,0,0,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Content="← Back"
                                Command="{Binding NavigateBackCommand}"
                                Padding="8,2" Margin="0,0,4,0" />
                        <ui:Button Command="{Binding RefreshCommand}"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Padding="8,2"
                                   ToolTip="Re-decompose current object (F5)" />
                        <ComboBox ItemsSource="{Binding TemplateAttributeScopes}"
                                  SelectedValue="{Binding TemplateAttributeScope}"
                                  SelectedValuePath="Scope"
                                  DisplayMemberPath="Label"
                                  VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="170"
                                  ToolTip="How much of the environment's template attribute list to read. Pinned attributes are always read and always shown first, in every mode.">
                                      <ComboBox.ItemContainerStyle>
                                          <Style TargetType="ComboBoxItem">
                                              <Setter Property="ToolTip" Value="{Binding Description}" />
                                          </Style>
                                      </ComboBox.ItemContainerStyle>
                                  </ComboBox>
                    </StackPanel>
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding Trail}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Title}"
                                            Command="{Binding DataContext.NavigateToFrameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="6,2" Margin="0,0,2,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand" />
                                    <TextBlock Text="›"
                                               VerticalAlignment="Center"
                                               Margin="0,0,2,0"
                                               Foreground="#888" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <!-- Last frame: bold, no trailing chevron -->
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="-1" />
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <DataGrid Name="PropertiesGrid"
                          ItemsSource="{Binding PropertiesView}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          CellStyle="{StaticResource HighlightedCellStyle}"
                          MouseDoubleClick="OnPropertiesGridDoubleClick">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding DrillIntoCommand}"
                                    CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Resources>
                        <Style x:Key="WrappedCell" TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Style>
                        <!-- Name column: prefers the attribute's declared label over the raw name in the tooltip. -->
                        <Style x:Key="NameCell" TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding NameTooltip}" />
                        </Style>
                        <Style x:Key="EllipsisCell" TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource HighlightedRowStyle}">
                            <Setter Property="Tag"
                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Drill in"
                                                  Command="{Binding PlacementTarget.Tag.DrillIntoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Open in new window"
                                                  Command="{Binding PlacementTarget.Tag.OpenInNewWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Show in viewport"
                                                  Command="{Binding PlacementTarget.Tag.HighlightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Show in Tekla"
                                                  Command="{Binding PlacementTarget.Tag.SelectPropertyInTeklaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Pin / unpin for this object type"
                                                  Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Save object as JSON (for LLM)…"
                                                  Command="{Binding PlacementTarget.Tag.DumpFrameJsonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Copy value"
                                                  Command="{Binding PlacementTarget.Tag.CopyPropertyValueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Copy name"
                                                  Command="{Binding PlacementTarget.Tag.CopyPropertyNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Copy &quot;Name = Value&quot;"
                                                  Command="{Binding PlacementTarget.Tag.CopyPropertyLineCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDrillable}" Value="True">
                                    <Setter Property="Foreground" Value="#1E5BFF" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <!--
                                        Workaround for the grouped DataGrid sizing issue: without
                                        binding the GroupItem width to the DataGrid viewport, each
                                        group is measured with infinite width and `*` columns fall
                                        back to MinWidth until the user resizes the window.
                                    -->
                                    <Setter Property="Width"
                                            Value="{Binding (FrameworkElement.ActualWidth),
                                                    RelativeSource={RelativeSource AncestorType={x:Type ScrollContentPresenter}}}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Stretch">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                            <TextBlock Text=" (" />
                                                            <TextBlock Text="{Binding ItemCount}" />
                                                            <TextBlock Text=")" />
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="26" CanUserResize="False" CanUserReorder="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PinButtonStyle}"
                                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanPin, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Pin this attribute so it stays at the top for every object of this type">
                                        <ui:SymbolIcon Symbol="Star20" Filled="{Binding IsPinned}" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="28" CanUserResize="False" CanUserReorder="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:SymbolIcon Symbol="{Binding Converter={StaticResource PropertyIcon}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="#666" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name"  Binding="{Binding Name}"
                                            Width="2*" MinWidth="120"
                                            ElementStyle="{StaticResource NameCell}" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}"
                                            Width="5*" MinWidth="200"
                                            ElementStyle="{StaticResource WrappedCell}" />
                        <DataGridTextColumn Header="Type"  Binding="{Binding ValueType}"
                                            Width="2*" MinWidth="100"
                                            ElementStyle="{StaticResource EllipsisCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <!-- Busy overlay: spans the whole central area while IsBusy=true. -->
            <Border Grid.Column="0" Grid.ColumnSpan="3"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                    Background="#80000000"
                    IsHitTestVisible="True">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="64" Height="64"
                                     Foreground="White" />
                    <TextBlock Text="{Binding Status}"
                               Margin="0,12,0,0"
                               Foreground="White"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                    <ui:Button Content="Cancel"
                               Icon="{ui:SymbolIcon DismissCircle24}"
                               Command="{Binding CancelCommand}"
                               Margin="0,16,0,0"
                               Padding="16,4"
                               HorizontalAlignment="Center"
                               ToolTip="Stop the running enumeration (keeps results gathered so far)" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
