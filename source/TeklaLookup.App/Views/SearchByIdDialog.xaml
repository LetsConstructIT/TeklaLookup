<ui:FluentWindow x:Class="TeklaLookup.App.Views.SearchByIdDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://lookupengine.com/xaml"
        Title="Search by ID / GUID"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Search by ID / GUID" />

        <TextBlock DockPanel.Dock="Top"
                   Margin="16,8,16,4"
                   TextWrapping="Wrap"
                   Foreground="#555"
                   Text="Paste integer IDs or GUIDs (one per line, or separated by space, comma, or semicolon)." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,8,16,16">
            <ui:Button Content="Find" Appearance="Primary"
                       Click="OnFindClicked"
                       IsDefault="True"
                       Padding="14,4" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" Padding="14,4" />
        </StackPanel>

        <TextBox Name="InputBox"
                 Margin="16,0,16,8"
                 AcceptsReturn="True"
                 AcceptsTab="False"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 Padding="6,4" />
    </DockPanel>
</ui:FluentWindow>
