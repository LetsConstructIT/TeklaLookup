<ui:FluentWindow x:Class="TeklaLookup.App.Views.EventMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://lookupengine.com/xaml"
        xmlns:vm="clr-namespace:TeklaLookup.App.ViewModels"
        Title="Event monitor"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Height="520" Width="820"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">
    <Window.DataContext>
        <vm:EventMonitorViewModel />
    </Window.DataContext>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Event monitor" />

        <DockPanel DockPanel.Dock="Top" Margin="12,8,12,8" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left"
                       Content="Start"
                       Command="{Binding StartCommand}"
                       Appearance="Primary"
                       Padding="12,4" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Left"
                    Content="Stop"
                    Command="{Binding StopCommand}"
                    Padding="12,4" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Left"
                    Content="Clear"
                    Command="{Binding ClearCommand}"
                    Padding="12,4" />
        </DockPanel>

        <DataGrid Name="EntriesGrid"
                  ItemsSource="{Binding Entries}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionMode="Extended"
                  PreviewMouseRightButtonDown="OnEntriesPreviewRightDown"
                  Margin="12,0,12,12">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Select in Tekla"
                              Command="{Binding PlacementTarget.DataContext.SelectInTeklaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time"   Binding="{Binding Time, StringFormat=HH\\:mm\\:ss.fff}" Width="Auto" MinWidth="100" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}"     Width="Auto" MinWidth="80"  />
                <DataGridTextColumn Header="Kind"   Binding="{Binding Kind}"       Width="Auto" MinWidth="120" />
                <DataGridTextColumn Header="Type"   Binding="{Binding ObjectType}" Width="2*"   MinWidth="120" />
                <DataGridTextColumn Header="Id"     Binding="{Binding ObjectId}"   Width="Auto" MinWidth="60"  />
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}"     Width="3*"   MinWidth="160" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</ui:FluentWindow>
