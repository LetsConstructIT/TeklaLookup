<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>
        <RootNamespace>TeklaLookup.App</RootNamespace>
        <AssemblyName>TeklaLookup</AssemblyName>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Resource Include="Resources\AppIcon.ico" />
    </ItemGroup>

    <!-- The .lst parser, tier classification and scope selection are internal; the test project
         drives them directly rather than through a Tekla-dependent surface. -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>TeklaLookup.App.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- Tekla Open API — compile-only; version selected by TeklaOpenApiVersion (Directory.Build.props):
         2021 floor in Release for forward-compat, locally-installed version in Debug. Members newer
         than the floor are invoked by reflection at runtime (see Services/OptionalTeklaApi.cs). -->
    <ItemGroup>
        <PackageReference Include="Tekla.Structures"           Version="$(TeklaOpenApiVersion).*" ExcludeAssets="runtime" />
        <PackageReference Include="Tekla.Structures.Model"     Version="$(TeklaOpenApiVersion).*" ExcludeAssets="runtime" />
        <PackageReference Include="Tekla.Structures.Drawing"   Version="$(TeklaOpenApiVersion).*" ExcludeAssets="runtime" />
        <PackageReference Include="Tekla.Structures.Dialog"    Version="$(TeklaOpenApiVersion).*" ExcludeAssets="runtime" />
        <PackageReference Include="Tekla.Structures.Catalogs"  Version="$(TeklaOpenApiVersion).*" ExcludeAssets="runtime" />
        <PackageReference Include="Tekla.Structures.Datatype"  Version="$(TeklaOpenApiVersion).*" ExcludeAssets="runtime" />
    </ItemGroup>

    <!-- Build tooling: patches the generated .exe.config so Tekla loads the app correctly -->
    <ItemGroup>
        <PackageReference Include="TSAppConfigPatcherTask" Version="*" />
    </ItemGroup>

    <!-- DataContractJsonSerializer (used by SettingsStore) lives in System.Runtime.Serialization -->
    <!-- System.Windows.Forms is used only for Screen.AllScreens (multi-monitor visibility check) -->
    <ItemGroup>
        <Reference Include="System.Runtime.Serialization" />
        <Reference Include="System.Windows.Forms" />
    </ItemGroup>

    <!-- UI framework — themed Fluent controls (re-namespaced WPF-UI fork) -->
    <ItemGroup>
        <ProjectReference Include="..\LookupEngine.UI\source\LookupEngine.UI\LookupEngine.UI.csproj" />
    </ItemGroup>

    <!--
        Copy supporting DLLs that Tekla's app.config redirects to specific versions but doesn't
        provide a <codeBase> for. Without these next to the .exe, the CLR honors the binding
        redirect but can't locate the file → FileNotFoundException at startup.
    -->
    <PropertyGroup>
        <TeklaBinDir>C:\TeklaStructures\$(TeklaVersion)\bin</TeklaBinDir>
    </PropertyGroup>
    <!-- Debug-only (TeklaVersion is empty in Release). These satisfy Tekla's app.config binding
         redirects when F5-debugging the standalone exe; in a Release/TSEP build the patcher is
         skipped and the app resolves them from the GAC, so there's nothing to copy. -->
    <Target Name="CopyTeklaSupportingDlls" AfterTargets="Build" Condition="'$(TeklaVersion)' != ''">
        <ItemGroup>
            <_TeklaSupportingDlls Include="$(TeklaBinDir)\System.Memory.dll" />
            <_TeklaSupportingDlls Include="$(TeklaBinDir)\System.Buffers.dll" />
            <_TeklaSupportingDlls Include="$(TeklaBinDir)\System.Threading.Tasks.Extensions.dll" />
            <_TeklaSupportingDlls Include="$(TeklaBinDir)\Microsoft.Bcl.AsyncInterfaces.dll" />
            <_TeklaSupportingDlls Include="$(TeklaBinDir)\Microsoft.Extensions.Logging.Abstractions.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(_TeklaSupportingDlls)"
              DestinationFolder="$(OutputPath)"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
